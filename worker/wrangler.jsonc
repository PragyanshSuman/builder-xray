{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "builder-xray",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Pre-built Astro output. Requests that match a file are served directly and
  // do NOT invoke the Worker, so they don't count toward the 100k/day quota.
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
